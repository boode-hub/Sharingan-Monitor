# Runtime state - generated by the script, specific to each machine
settings.json
sharingan.pid
launcher.vbs

# Local-only material (backups, notes, raw recordings) - see _local/
_local/

# Editor / tool config
.claude/

# Scratch files from debugging / render tests
_*.ps1
_*.png
_*.log
*.bak

# User profiles (personal settings sets)
profiles/

# Eye artwork (third-party SVGs / pictures) - kept local, not published.
# The app falls back to its built-in drawings when this folder is absent.
eyes/
