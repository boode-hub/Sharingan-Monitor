# Runtime state - generated by the script, specific to each machine
settings.json
sharingan.pid

# Generated by install-startup.bat
launcher.vbs

# Scratch files from debugging / render tests
_*.ps1
_*.png
_*.log

# Local backup snapshots - git history serves this purpose for the public repo.
# The files stay on disk, they are just not published.
*.bak

# Source recordings live in the repo root; the published copies are in docs/
/*.gif
